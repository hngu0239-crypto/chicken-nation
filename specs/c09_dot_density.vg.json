{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Chart 9 (dot density map, map 3). Each dot = $5 million of chicken meat or egg production in 2020-2021, placed at a random position inside its SA4 region. Click the legend to show one product. Height and base-map colours match Chart 8 so the two maps read as a pair.",
  "width": "container",
  "height": 400,
  "projection": {
    "type": "conicEqualArea",
    "parallels": [-18, -36],
    "rotate": [-133, 0, 0]
  },
  "layer": [
    {
      "data": {
        "url": "data/states.geojson",
        "format": {"type": "json", "property": "features"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#E8E1D2",
        "stroke": "#F6F1E7",
        "strokeWidth": 1.5
      }
    },
    {
      "data": {"url": "data/c09_poultry_dots.csv"},
      "params": [
        {
          "name": "pick",
          "select": {"type": "point", "fields": ["type"]},
          "bind": "legend"
        }
      ],
      "mark": {"type": "circle", "size": 13},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "color": {
          "field": "type",
          "type": "nominal",
          "scale": {
            "domain": ["Chicken meat", "Eggs"],
            "range": ["#D99520", "#3F7FA6"]
          },
          "legend": {
            "title": "1 dot = $5 million",
            "orient": "top-left",
            "symbolSize": 110,
            "titleColor": "#26382F",
            "titleFontWeight": 600,
            "labelColor": "#535C56",
            "labelFontSize": 12
          }
        },
        "opacity": {
          "condition": {"param": "pick", "value": 0.85},
          "value": 0.06
        },
        "tooltip": [
          {"field": "region", "title": "Region"},
          {"field": "type", "title": "Product"}
        ]
      }
    },
    {
      "data": {
        "values": [
          {"lon": 124, "lat": -23.5, "t": "SA and WA chicken meat is not published,"},
          {"lon": 124, "lat": -25.2, "t": "so only their egg farms appear"}
        ]
      },
      "mark": {"type": "text", "fontSize": 11, "fontStyle": "italic", "color": "#535C56"},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "t"}
      }
    }
  ],
  "config": {
    "view": {"stroke": null}
  }
}