{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Chart 11 (horizon chart). Yearly % change in chickens slaughtered for Australia and the three biggest producing states. Each row is folded into bands of 10 percentage points: orange = growth, blue = decline, darker = bigger change (changes larger than 20% are shown at the darkest shade).",
  "width": "container",
  "height": 260,
  "data": {
    "url": "data/c11_horizon_change.csv"
  },
  "transform": [
    {
      "calculate": "toNumber(datum.change_pct)",
      "as": "v"
    },
    {
      "calculate": "({'Australia': 3, 'New South Wales': 2, 'Victoria': 1, 'Queensland': 0}[datum.region]) * 10",
      "as": "base"
    },
    {
      "calculate": "datum.base + min(max(datum.v, 0), 10)",
      "as": "pos1"
    },
    {
      "calculate": "datum.base + min(max(datum.v - 10, 0), 10)",
      "as": "pos2"
    },
    {
      "calculate": "datum.base + min(max(-datum.v, 0), 10)",
      "as": "neg1"
    },
    {
      "calculate": "datum.base + min(max(-datum.v - 10, 0), 10)",
      "as": "neg2"
    },
    {
      "calculate": "{'Australia': 'Australia', 'New South Wales': 'NSW', 'Victoria': 'Vic', 'Queensland': 'Qld'}[datum.region]",
      "as": "abbr"
    }
  ],
  "encoding": {
    "x": {
      "field": "fy_end",
      "type": "quantitative",
      "scale": {
        "domain": [
          1967,
          2026
        ],
        "nice": false
      },
      "axis": {
        "title": null,
        "format": "d",
        "values": [
          1970,
          1980,
          1990,
          2000,
          2010,
          2020
        ],
        "grid": false,
        "domain": false
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "area",
        "color": "#F3C987",
        "interpolate": "monotone"
      },
      "encoding": {
        "y": {
          "field": "pos1",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              40
            ]
          },
          "axis": null
        },
        "y2": {
          "field": "base"
        },
        "detail": {
          "field": "region"
        }
      }
    },
    {
      "mark": {
        "type": "area",
        "color": "#C8730F",
        "interpolate": "monotone"
      },
      "encoding": {
        "y": {
          "field": "pos2",
          "type": "quantitative"
        },
        "y2": {
          "field": "base"
        },
        "detail": {
          "field": "region"
        }
      }
    },
    {
      "mark": {
        "type": "area",
        "color": "#A9C8DE",
        "interpolate": "monotone"
      },
      "encoding": {
        "y": {
          "field": "neg1",
          "type": "quantitative"
        },
        "y2": {
          "field": "base"
        },
        "detail": {
          "field": "region"
        }
      }
    },
    {
      "mark": {
        "type": "area",
        "color": "#3F7FA6",
        "interpolate": "monotone"
      },
      "encoding": {
        "y": {
          "field": "neg2",
          "type": "quantitative"
        },
        "y2": {
          "field": "base"
        },
        "detail": {
          "field": "region"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "r": 1
          },
          {
            "r": 2
          },
          {
            "r": 3
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "white",
        "strokeWidth": 2
      },
      "encoding": {
        "y": {
          "field": "r",
          "type": "quantitative"
        },
        "x": {
          "value": 0
        },
        "x2": {
          "value": {
            "expr": "width"
          }
        }
      },
      "transform": [
        {
          "calculate": "datum.r * 10",
          "as": "r"
        }
      ]
    },
    {
      "transform": [
        {
          "filter": "datum.fy_end == 1967"
        },
        {
          "calculate": "datum.base + 10 * 0.5",
          "as": "label_y"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -8,
        "fontSize": 12,
        "fontWeight": 700,
        "color": "#1E2621"
      },
      "encoding": {
        "y": {
          "field": "label_y",
          "type": "quantitative"
        },
        "x": {
          "value": 0
        },
        "text": {
          "field": "abbr"
        }
      }
    },
    {
      "transform": [
        {
          "pivot": "abbr",
          "value": "v",
          "groupby": [
            "fy_end",
            "fy"
          ]
        }
      ],
      "params": [
        {
          "name": "hoverYear",
          "select": {
            "type": "point",
            "fields": [
              "fy_end"
            ],
            "nearest": true,
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#1E2621",
        "strokeWidth": 1
      },
      "encoding": {
        "opacity": {
          "condition": {
            "param": "hoverYear",
            "empty": false,
            "value": 0.5
          },
          "value": 0
        },
        "tooltip": [
          {
            "field": "fy",
            "title": "Year"
          },
          {
            "field": "Australia",
            "title": "Australia (% change)",
            "format": "+.1f"
          },
          {
            "field": "NSW",
            "title": "NSW (% change)",
            "format": "+.1f"
          },
          {
            "field": "Vic",
            "title": "Vic (% change)",
            "format": "+.1f"
          },
          {
            "field": "Qld",
            "title": "Qld (% change)",
            "format": "+.1f"
          }
        ]
      }
    }
  ]
}